# === TEXT FILES - Force LF + UTF-8 ===
*.md text eol=lf encoding=utf-8
*.js text eol=lf encoding=utf-8
*.jsx text eol=lf encoding=utf-8
*.json text eol=lf encoding=utf-8
*.css text eol=lf encoding=utf-8
*.html text eol=lf encoding=utf-8
*.sql text eol=lf encoding=utf-8
*.sh text eol=lf encoding=utf-8
*.yml text eol=lf encoding=utf-8
*.yaml text eol=lf encoding=utf-8
*.txt text eol=lf encoding=utf-8
*.env text eol=lf encoding=utf-8
*.example text eol=lf encoding=utf-8

# === BINARY FILES ===
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# === DOCKER ===
Dockerfile text eol=lf
docker-compose.yml text eol=lf

# === SCRIPTS ===
*.sh text eol=lf
*.bash text eol=lf

# === EXPORT ATTRIBUTES (pour archives) ===
.gitattributes export-ignore
.gitignore export-ignore
.editorconfig export-ignore
