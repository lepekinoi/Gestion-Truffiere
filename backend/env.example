# ============================================================
# Configuration de l'environnement - API Truffière
# Copiez ce fichier en .env et modifiez les valeurs
# ============================================================

# Mode d'exécution (development, production, test)
NODE_ENV=development

# Port du serveur
PORT=3001

# ============================================================
# BASE DE DONNÉES POSTGRESQL
# ============================================================

DB_HOST=postgres
DB_PORT=5432
DB_NAME=truffiere
DB_USER=unstuffed1004
DB_PASSWORD=WeR87fFC8SN5IJUGz4w6Tl87t1Fm2840GepKl82Xe666J0D7hD

# ============================================================
# AUTHENTIFICATION JWT
# ============================================================

# Clé secrète pour signer les tokens JWT
# IMPORTANT: Générez une clé unique et sécurisée en production!
# Utilisez: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGEZ_MOI_EN_PRODUCTION_utilisez_une_cle_de_64_caracteres_minimum_generee_aleatoirement

# Durée de validité du token d'accès
# Formats: 15m (15 minutes), 1h (1 heure), 1d (1 jour)
JWT_EXPIRES_IN=15m

# Durée de validité du refresh token
REFRESH_TOKEN_EXPIRES_IN=7d

# Nombre de rounds pour le hashage bcrypt (10-12 recommandé)
BCRYPT_ROUNDS=12

# ============================================================
# SÉCURITÉ
# ============================================================

# URL du frontend (pour CORS)
FRONTEND_URL=http://localhost:3000

# Activer les logs de sécurité détaillés
SECURITY_LOGS=true

# ============================================================
# OPTIONNEL - EMAIL (pour réinitialisation mot de passe)
# ============================================================

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=your_smtp_password
# SMTP_FROM=Truffière <noreply@example.com>

# ============================================================
# OPTIONNEL - SERVICES EXTERNES
# ============================================================

# Clé API OpenWeatherMap (pour le widget météo)
# OPENWEATHER_API_KEY=your_api_key_here
