# ========================================
# CONFIGURATION SERVEUR - GESTION TRUFFIÈRE V2.0
# ========================================

# Base de données PostgreSQL
# Hôte de la base de données (postgres pour Docker, localhost pour dev local)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=truffiere_db
# Nom d'utilisateur PostgreSQL (le dump init_database.sql utilise "unstuffed1004" comme owner —
# voir database/README.md, section "Prérequis important" pour la procédure de contournement)
DB_USER=unstuffed1004
# Mot de passe PostgreSQL (IMPORTANT: Utilisez un mot de passe fort en production)
DB_PASSWORD=votre_mot_de_passe_securise_ici

# JWT Authentication
# Secret JWT (IMPORTANT: Générez une clé aléatoire forte avec: openssl rand -hex 64)
JWT_SECRET=votre_secret_jwt_tres_long_et_aleatoire_ici
# Durée de validité du token d'accès (15m recommandé)
JWT_EXPIRES_IN=15m
# Durée de validité du refresh token en jours
REFRESH_TOKEN_EXPIRES_DAYS=7

# Sécurité
# Activer les logs de sécurité détaillés (true/false)
SECURITY_LOGS=true
# Nombre de rounds pour bcrypt (12 recommandé, plus = plus sécurisé mais plus lent)
BCRYPT_ROUNDS=12

# CORS
# Origines autorisées (séparées par des virgules si plusieurs)
CORS_ORIGINS=https://votre-domaine.com

# URLs Frontend et Backend
# URL interne du frontend (pour Docker)
FRONTEND_URL=http://frontend:3000
# URL interne du backend (pour Docker)
BACKEND_INTERNAL_URL=http://backend:3001
# URL publique du backend (accessible depuis l'extérieur)
BACKEND_PUBLIC_URL=https://votre-domaine.com/api

# Configuration Serveur
# Port d'écoute du serveur backend
PORT=3001
# Environnement (development/production/test)
NODE_ENV=production
