# EditorConfig: https://EditorConfig.org
root = true

# === DEFAULTS (tous fichiers) ===
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# === JAVASCRIPT / REACT ===
[*.{js,jsx}]
indent_style = space
indent_size = 2
max_line_length = 100

# === JSON ===
[*.json]
indent_style = space
indent_size = 2

# === YAML (Docker Compose, GitHub Actions) ===
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# === MARKDOWN ===
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# === SQL ===
[*.sql]
indent_style = space
indent_size = 2

# === HTML / CSS ===
[*.{html,css}]
indent_style = space
indent_size = 2

# === PACKAGE.JSON (spécial) ===
[package.json]
indent_style = space
indent_size = 2
